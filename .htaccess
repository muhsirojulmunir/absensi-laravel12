# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
<IfModule lsapi_module>
  AddHandler application/x-httpd-ea-php84 .php
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !extract\.php$
    RewriteCond %{REQUEST_URI} !info\.php$
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
